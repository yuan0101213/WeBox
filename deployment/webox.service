[Unit]
Description=WeBox Spring Boot backend
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=webox
Group=webox
WorkingDirectory=/opt/webox/backend
EnvironmentFile=/etc/webox/backend.env
ExecStart=/usr/bin/java -jar /opt/webox/backend/app.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
