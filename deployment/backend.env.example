# Copy to /etc/webox/backend.env, chmod 600, replace placeholders privately.
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:13306/webox?connectionTimeZone=Asia/Shanghai&characterEncoding=UTF-8
DB_USERNAME=webox
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
DEEPSEEK_API_KEY=REPLACE_WITH_PRIVATE_API_KEY
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional first privileged-account bootstrap; remove after initial startup.
# WEBOX_ADMIN_EMAIL=admin@example.com
# WEBOX_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD
